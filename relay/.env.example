# Relay server configuration
PORT=8080
# Optional: serve a built game collection from this directory on the same port.
# The combined Docker image sets this to /collection.
# STATIC_DIR=/absolute/path/to/deploy
MAX_ROOMS=100
# Capacity for modern namespaced rooms; legacy Sea Strike rooms remain capped at two.
MAX_CLIENTS_PER_ROOM=2
ROOM_TIMEOUT_MS=3600000
LOG_LEVEL=info
