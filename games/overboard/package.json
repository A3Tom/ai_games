{
  "name": "overboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/fetch-emulator.mjs && node scripts/prepare-media.mjs && vite --host 0.0.0.0",
    "build": "node scripts/fetch-emulator.mjs && node scripts/prepare-media.mjs && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "emulator:fetch": "node scripts/fetch-emulator.mjs",
    "resources:import": "node scripts/import-media.mjs",
    "test": "node --test scripts/*.test.mjs && vitest run"
  },
  "devDependencies": {
    "jsdom": "^28.0.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.1",
    "vitest": "^3.2.4"
  }
}
